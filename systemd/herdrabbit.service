[Unit]
Description=HerdRabbit
Documentation=file:///home/your-user/HerdRabbit/README.md

[Service]
Type=simple
WorkingDirectory=/home/your-user/HerdRabbit
Environment=HERDR_WEB_PORT=38787
Environment=HERDR_WEB_HOST=127.0.0.1
Environment=HERDR_WEB_ALLOWED_HOSTS=server.example-tailnet.ts.net
Environment=HERDR_WEB_AUTH_FILE=/home/your-user/.config/herdr-bridge/auth.json
Environment=HERDR_BIN=/home/your-user/.local/bin/herdr
ExecStart=/usr/bin/node /home/your-user/HerdRabbit/src/index.mjs
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
